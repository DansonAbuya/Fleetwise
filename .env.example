# Required — Google OAuth (Cloud Console → APIs & Services → Credentials)
# Authorized redirect URI: {AUTH_URL}/auth/callback/google
# Aliases also accepted: AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required — signs the session cookie. Alias also accepted: BETTER_AUTH_SECRET
AUTH_SECRET=
# Public origin of this app. Alias also accepted: BETTER_AUTH_URL
AUTH_URL=http://localhost:3000

# Required — Neon Postgres (https://console.neon.tech)
# Copy the connection string, then: npx prisma db push
# Restart npm run dev, then Settings → Import STOCK DOCUMENTS.
# Use the pooled URL if Neon shows one; otherwise the main connection string is fine.
DATABASE_URL=

# Optional — used only when fleetwise-config.json is not in Drive yet
DRIVE_FOLDER_LOGBOOKS=
DRIVE_FOLDER_CERTIFICATES=
DRIVE_FOLDER_PHOTOS=
DRIVE_FOLDER_AGREEMENTS=
DRIVE_FOLDER_COLLATERAL=
DRIVE_SPREADSHEET_ID=
DRIVE_MATCH_THRESHOLD=85

# Optional — Gmail inboxes. Aliases: DRIVE_INSURANCE_INBOX_EMAIL, DRIVE_LOGBOOKS_INBOX_EMAIL
GMAIL_INSURANCE_INBOX=
GMAIL_LOGBOOKS_INBOX=

# Optional — photo plate OCR (local Tesseract; no Cloud Vision billing)
# PHOTO_PLATE_PATTERN overrides the prefix pattern when set
PHOTO_PLATE_PREFIX=KM
PHOTO_PLATE_PATTERN=
PHOTO_OCR_LOG=
PHOTO_OCR_DEBUG=

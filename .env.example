GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Google Cloud authorized redirect URI: {AUTH_URL}/auth/callback/google

# Optional fallbacks if fleetwise-config.json is not in Drive yet
# DRIVE_FOLDER_LOGBOOKS=
# DRIVE_FOLDER_CERTIFICATES=
# DRIVE_FOLDER_PHOTOS=
# DRIVE_FOLDER_AGREEMENTS=
# DRIVE_FOLDER_COLLATERAL=
# DRIVE_MATCH_THRESHOLD=85
# Enable Google Sheets API on the same GCP project
# DRIVE_SPREADSHEET_ID=

# Photo OCR runs locally with Tesseract. No Cloud Vision billing required.

# Neon Postgres (https://console.neon.tech — Free plan)
# Create a project, copy the connection string, then:
#   npx prisma db push
# Restart npm run dev, then Settings → Import STOCK DOCUMENTS.
# Use the pooled URL if Neon shows one; otherwise the main connection string is fine.

